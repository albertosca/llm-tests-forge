{
	"name": "llm-tests-forge",
	"version": "0.1.0",
	"description": "Forge reviewed regression suites for your LLM features and emit them for promptfoo",
	"license": "MIT",
	"type": "module",
	"bin": {
		"llm-tests-forge": "src/cli/bin.ts"
	},
	"scripts": {
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"build:binary": "bun build --compile src/cli/bin.ts --outfile dist/llm-tests-forge",
		"check": "bun run lint && bun run typecheck && bun test",
		"validate:example": "bunx promptfoo@0.123.0 validate -c examples/moonlighter-classify-email/.forge/promptfooconfig.yaml",
		"test:live": "FORGE_LIVE=1 bun test tests/live --config=bunfig.live.toml",
		"test:shims": "FORGE_SHIMS=1 bun test tests/shims --timeout 600000 --config=bunfig.shims.toml",
		"test:packages": "FORGE_PACKAGES=1 bun test tests/packages --timeout 600000 --config=bunfig.packages.toml",
		"release:build": "bun scripts/release/build-binaries.ts dist",
		"release:stamp": "bun scripts/release/version.ts stamp"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.53",
		"@ai-sdk/google": "4.0.69",
		"@ai-sdk/openai": "4.0.66",
		"ai": "7.0.100",
		"yaml": "2.9.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/bun": "latest",
		"typescript": "7.0.2"
	}
}
