.worktrees/
.superpowers/
node_modules/
coverage/
# Stryker's sandbox is a full copy of the repository (biome.json included) and its report is large
.stryker-tmp/
reports/
**/.forge/failures/
**/.forge/usage.jsonl
__pycache__/
dist/
*.bun-build

# Planning docs live in the private repo albertosca/private-project-docs (llm-tests-forge/), symlinked here.
/docs/superpowers

# Rendered at release time from SHA256SUMS (scripts/release/hex-checksums.ts)
/packages/hex/checksums.exs
/packages/hex/_build/
/packages/hex/deps/
/packages/hex/erl_crash.dump

# The binary a gemspec run copies to exe/<platform>/ (scripts/release/gems.ts builds from a scratch copy, but a direct gem build writes here)
/packages/gem/exe/*/
